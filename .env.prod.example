# 운영 서버 환경 변수 템플릿
# 운영 서버에서 사용할 환경 변수 예시

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (운영 서버)
DB_URL=jdbc:postgresql://prod-db-server.example.com:5432/template_prod_db
DB_USERNAME=prod_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Redis Configuration (운영 서버)
REDIS_HOST=prod-redis-server.example.com
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
REDIS_SSL_ENABLED=true

# JWT Configuration
JWT_SECRET=CHANGE_THIS_VERY_STRONG_SECRET_KEY
JWT_EXPIRATION=3600000

# 로그 레벨
LOG_LEVEL=WARN

# 기타 설정
TZ=Asia/Seoul

# Monitoring (운영 환경 추가 설정)
SENTRY_DSN=your-sentry-dsn-here
NEW_RELIC_LICENSE_KEY=your-newrelic-key-here
