# 개발 서버 환경 변수 템플릿
# 개발 서버에서 사용할 환경 변수 예시

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (개발 서버)
DB_URL=jdbc:postgresql://dev-db-server.example.com:5432/template_dev_db
DB_USERNAME=dev_user
DB_PASSWORD=change_this_password_for_dev

# Redis Configuration (개발 서버)
REDIS_HOST=dev-redis-server.example.com
REDIS_PORT=6379
REDIS_PASSWORD=change_this_password_for_redis
REDIS_SSL_ENABLED=false

# JWT Configuration
JWT_SECRET=dev-secret-key-change-this
JWT_EXPIRATION=3600000

# 로그 레벨
LOG_LEVEL=INFO

# 기타 설정
TZ=Asia/Seoul
