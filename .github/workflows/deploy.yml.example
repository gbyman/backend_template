name: Build & Deploy

on:
  push:
    branches:
      - main
      - develop
  pull_request:
    branches:
      - main

env:
  REGISTRY: ${{ secrets.REGISTRY_URL }}
  API_IMAGE: ${{ secrets.REGISTRY_URL }}/backend-api
  BATCH_IMAGE: ${{ secrets.REGISTRY_URL }}/backend-batch

jobs:
  # ============================================
  # 빌드 및 테스트
  # ============================================
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Set up JDK 21
      uses: actions/setup-java@v4
      with:
        java-version: '21'
        distribution: 'temurin'
        cache: gradle

    - name: Grant execute permission for gradlew
      run: chmod +x gradlew

    - name: Build with Gradle
      run: ./gradlew clean build

    - name: Upload API artifact
      uses: actions/upload-artifact@v4
      with:
        name: api-jar
        path: module-api/build/libs/*.jar
        retention-days: 1

    - name: Upload Batch artifact
      uses: actions/upload-artifact@v4
      with:
        name: batch-jar
        path: module-batch/build/libs/*.jar
        retention-days: 1

    - name: Upload test reports
      if: always()
      uses: actions/upload-artifact@v4
      with:
        name: test-reports
        path: |
          module-api/build/reports/
          module-batch/build/reports/
        retention-days: 7

  # ============================================
  # Docker 이미지 빌드 & Push
  # ============================================
  docker:
    needs: build
    runs-on: ubuntu-latest
    if: github.event_name == 'push'

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Set up Docker Buildx
      uses: docker/setup-buildx-action@v3

    - name: Login to Container Registry
      uses: docker/login-action@v3
      with:
        registry: ${{ secrets.REGISTRY_URL }}
        username: ${{ secrets.REGISTRY_USERNAME }}
        password: ${{ secrets.REGISTRY_PASSWORD }}

    - name: Build and push API image
      uses: docker/build-push-action@v5
      with:
        context: .
        file: module-api/Dockerfile
        push: true
        tags: |
          ${{ env.API_IMAGE }}:${{ github.sha }}
          ${{ env.API_IMAGE }}:latest
        cache-from: type=gha
        cache-to: type=gha,mode=max

    - name: Build and push Batch image
      uses: docker/build-push-action@v5
      with:
        context: .
        file: module-batch/Dockerfile
        push: true
        tags: |
          ${{ env.BATCH_IMAGE }}:${{ github.sha }}
          ${{ env.BATCH_IMAGE }}:latest
        cache-from: type=gha
        cache-to: type=gha,mode=max

  # ============================================
  # 개발 환경 배포
  # ============================================
  deploy-dev:
    needs: docker
    runs-on: ubuntu-latest
    environment: development
    if: github.ref == 'refs/heads/develop'

    steps:
    - name: Deploy to Dev Server
      uses: appleboy/ssh-action@v1
      with:
        host: ${{ secrets.DEV_SERVER_HOST }}
        username: ${{ secrets.DEV_SERVER_USER }}
        key: ${{ secrets.DEV_SERVER_SSH_KEY }}
        script: |
          docker login -u ${{ secrets.REGISTRY_USERNAME }} -p ${{ secrets.REGISTRY_PASSWORD }} ${{ secrets.REGISTRY_URL }}

          # API 서버 배포
          docker pull ${{ env.API_IMAGE }}:${{ github.sha }}
          docker stop backend-api-dev || true
          docker rm backend-api-dev || true
          docker run -d \
            --name backend-api-dev \
            --restart unless-stopped \
            -e SPRING_PROFILES_ACTIVE=dev \
            -e DB_URL=${{ secrets.DEV_DB_URL }} \
            -e DB_USERNAME=${{ secrets.DEV_DB_USERNAME }} \
            -e DB_PASSWORD=${{ secrets.DEV_DB_PASSWORD }} \
            -e REDIS_HOST=${{ secrets.DEV_REDIS_HOST }} \
            -e REDIS_PORT=${{ secrets.DEV_REDIS_PORT }} \
            -e REDIS_PASSWORD=${{ secrets.DEV_REDIS_PASSWORD }} \
            -e JWT_SECRET=${{ secrets.DEV_JWT_SECRET }} \
            -e JASYPT_ENCRYPTOR_PASSWORD=${{ secrets.DEV_JASYPT_PASSWORD }} \
            -e CORS_ALLOWED_ORIGIN=${{ secrets.DEV_CORS_ORIGIN }} \
            -v /app/logs/api:/app/logs \
            -v /app/uploads:/app/uploads \
            -p 8080:8080 \
            ${{ env.API_IMAGE }}:${{ github.sha }}

          # Batch 서버 배포
          docker pull ${{ env.BATCH_IMAGE }}:${{ github.sha }}
          docker stop backend-batch-dev || true
          docker rm backend-batch-dev || true
          docker run -d \
            --name backend-batch-dev \
            --restart unless-stopped \
            -e SPRING_PROFILES_ACTIVE=dev \
            -e DB_URL=${{ secrets.DEV_DB_URL }} \
            -e DB_USERNAME=${{ secrets.DEV_DB_USERNAME }} \
            -e DB_PASSWORD=${{ secrets.DEV_DB_PASSWORD }} \
            -e REDIS_HOST=${{ secrets.DEV_REDIS_HOST }} \
            -e REDIS_PORT=${{ secrets.DEV_REDIS_PORT }} \
            -e REDIS_PASSWORD=${{ secrets.DEV_REDIS_PASSWORD }} \
            -e JASYPT_ENCRYPTOR_PASSWORD=${{ secrets.DEV_JASYPT_PASSWORD }} \
            -v /app/logs/batch:/app/logs \
            -p 8090:8090 \
            ${{ env.BATCH_IMAGE }}:${{ github.sha }}

  # ============================================
  # 운영 환경 배포
  # ============================================
  deploy-prod:
    needs: docker
    runs-on: ubuntu-latest
    environment: production
    if: github.ref == 'refs/heads/main'

    steps:
    - name: Deploy to Production Server
      uses: appleboy/ssh-action@v1
      with:
        host: ${{ secrets.PROD_SERVER_HOST }}
        username: ${{ secrets.PROD_SERVER_USER }}
        key: ${{ secrets.PROD_SERVER_SSH_KEY }}
        script: |
          docker login -u ${{ secrets.REGISTRY_USERNAME }} -p ${{ secrets.REGISTRY_PASSWORD }} ${{ secrets.REGISTRY_URL }}

          # API 서버 배포
          docker pull ${{ env.API_IMAGE }}:${{ github.sha }}
          docker stop backend-api || true
          docker rm backend-api || true
          docker run -d \
            --name backend-api \
            --restart unless-stopped \
            -e SPRING_PROFILES_ACTIVE=prod \
            -e DB_URL=${{ secrets.PROD_DB_URL }} \
            -e DB_USERNAME=${{ secrets.PROD_DB_USERNAME }} \
            -e DB_PASSWORD=${{ secrets.PROD_DB_PASSWORD }} \
            -e REDIS_HOST=${{ secrets.PROD_REDIS_HOST }} \
            -e REDIS_PORT=${{ secrets.PROD_REDIS_PORT }} \
            -e REDIS_PASSWORD=${{ secrets.PROD_REDIS_PASSWORD }} \
            -e JWT_SECRET=${{ secrets.PROD_JWT_SECRET }} \
            -e JASYPT_ENCRYPTOR_PASSWORD=${{ secrets.PROD_JASYPT_PASSWORD }} \
            -e CORS_ALLOWED_ORIGIN=${{ secrets.PROD_CORS_ORIGIN }} \
            -v /app/logs/api:/app/logs \
            -v /app/uploads:/app/uploads \
            -p 8080:8080 \
            ${{ env.API_IMAGE }}:${{ github.sha }}

          # Batch 서버 배포
          docker pull ${{ env.BATCH_IMAGE }}:${{ github.sha }}
          docker stop backend-batch || true
          docker rm backend-batch || true
          docker run -d \
            --name backend-batch \
            --restart unless-stopped \
            -e SPRING_PROFILES_ACTIVE=prod \
            -e DB_URL=${{ secrets.PROD_DB_URL }} \
            -e DB_USERNAME=${{ secrets.PROD_DB_USERNAME }} \
            -e DB_PASSWORD=${{ secrets.PROD_DB_PASSWORD }} \
            -e REDIS_HOST=${{ secrets.PROD_REDIS_HOST }} \
            -e REDIS_PORT=${{ secrets.PROD_REDIS_PORT }} \
            -e REDIS_PASSWORD=${{ secrets.PROD_REDIS_PASSWORD }} \
            -e JASYPT_ENCRYPTOR_PASSWORD=${{ secrets.PROD_JASYPT_PASSWORD }} \
            -v /app/logs/batch:/app/logs \
            -p 8090:8090 \
            ${{ env.BATCH_IMAGE }}:${{ github.sha }}
