<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<!--
    Checkstyle 예외 처리
    특정 파일/패턴에 대해 규칙 무시
-->
<suppressions>
    <!-- 테스트 코드는 일부 규칙 완화 -->
    <suppress checks="MagicNumber" files=".*Test\.java"/>
    <suppress checks="JavadocMethod" files=".*Test\.java"/>
    <suppress checks="MethodLength" files=".*Test\.java"/>

    <!-- DTO/Entity는 Javadoc 불필요 -->
    <suppress checks="JavadocType" files=".*Dto\.java"/>
    <suppress checks="JavadocType" files=".*Entity\.java"/>
    <suppress checks="JavadocType" files=".*Vo\.java"/>

    <!-- 생성된 코드 제외 -->
    <suppress checks=".*" files=".*[\\/]generated[\\/].*"/>
    <suppress checks=".*" files=".*[\\/]build[\\/].*"/>
    <suppress checks=".*" files="Q.*\.java"/>  <!-- QueryDSL -->

    <!-- Application 클래스 예외 -->
    <suppress checks="HideUtilityClassConstructor" files=".*Application\.java"/>

    <!-- Config 클래스는 파라미터 개수 제한 완화 -->
    <suppress checks="ParameterNumber" files=".*Config\.java"/>
</suppressions>
