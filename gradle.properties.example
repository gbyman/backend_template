# ==========================================
# Gradle 설정 파일 예시
# ==========================================
#
# 사용법:
# 1. 이 파일을 gradle.properties로 복사
# 2. Nexus 사용 시 nexus 관련 값 설정
# 3. gradle.properties는 .gitignore에 포함되어 보안 유지
#
# ==========================================

# JVM 설정
org.gradle.jvmargs=-Xmx2048m -XX:MaxMetaspaceSize=512m
org.gradle.daemon=true
org.gradle.parallel=true
org.gradle.caching=true

# Java Home (선택사항)
# org.gradle.java.home=/usr/lib/jvm/java-21-openjdk-amd64

# ==========================================
# Nexus Repository 설정
# ==========================================
# Nexus를 사용하지 않으면 주석 처리

# Nexus Repository URL
nexusUrl=https://nexus.example.com/repository
# 또는
# nexusUrl=http://localhost:8081/repository

# Maven Group Repository (proxy + hosted)
mavenGroupUrl=${nexusUrl}/maven-public

# Maven Snapshots Repository
mavenSnapshotsUrl=${nexusUrl}/maven-snapshots

# Maven Releases Repository
mavenReleasesUrl=${nexusUrl}/maven-releases

# Gradle Plugin Portal Proxy
gradlePluginPortalUrl=${nexusUrl}/gradle-plugin-portal

# ==========================================
# Nexus 인증 정보
# ==========================================
# 보안을 위해 환경변수 사용 권장:
# export NEXUS_USERNAME=your-username
# export NEXUS_PASSWORD=your-password

# 직접 입력 (비권장, 로컬 개발 전용)
nexusUsername=${env.NEXUS_USERNAME}
nexusPassword=${env.NEXUS_PASSWORD}

# 또는 직접 값 입력 (절대 Git에 커밋하지 말 것!)
# nexusUsername=your-username
# nexusPassword=your-password

# ==========================================
# Publish 설정 (라이브러리 배포 시)
# ==========================================
# 배포할 Repository 선택
publishUrl=${mavenReleasesUrl}
publishUsername=${nexusUsername}
publishPassword=${nexusPassword}

# ==========================================
# 프로젝트 정보
# ==========================================
# Group ID (Maven 배포 시 사용)
projectGroup=app.backend
projectVersion=0.0.1-SNAPSHOT

# ==========================================
# 기타 설정
# ==========================================
# 빌드 캐시 활성화
org.gradle.configuration-cache=false
# Warning을 에러로 처리
# org.gradle.warning.mode=all

# Kotlin DSL 설정 (Kotlin 사용 시)
# kotlin.incremental=true
# kotlin.caching.enabled=true
